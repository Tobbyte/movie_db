def prompt_validated(prompt: str, validators: list) -> str:
    """Ask for input until it passes all validators.

    validators: list of (check_fn, error_msg) tuples.
    check_fn takes the stripped input string, returns True if valid.
    """
    while True:
        value = get_user_input_colored(prompt).strip()
        for check, error_msg in validators:
            if not check(value):
                output(error_msg, color="red")
                break
        else:
            return value  # alle Checks bestanden


def is_in_range(value: str) -> bool:
    return MOVIE_MIN_RATING <= float(value) <= MOVIE_MAX_RATING


rating_validators = [
    (lambda v: v != "", "Rating required"),
    (is_num, "Rating must be a number"),
    (is_in_range, "Rating must be between 0 - 10"),
]

new_rating = prompt_validated(
    "Enter new movies rating (0-10): ", rating_validators
)
